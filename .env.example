# Conexión de la aplicación (desarrollo).
DATABASE_URL="postgresql://contact_manager:contact_manager@localhost:5432/contact_manager"

# Conexión exclusiva de las pruebas de integración.
TEST_DATABASE_URL="postgresql://contact_manager:contact_manager@localhost:5432/contact_manager_test"

# Modo de acceso del despliegue: read-only | read-write (variable de servidor, nunca NEXT_PUBLIC_).
# Sin valor: read-write en desarrollo y pruebas; read-only en producción (fail-closed).
# La demostración en Vercel usa read-only (ver docs/despliegue-demo.md).
# CONTACTS_ACCESS_MODE="read-write"
